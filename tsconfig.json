{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/app/**/*.ts", "src/app/**/*.tsx", "src/components/**/*.ts", "src/components/**/*.tsx", "src/lib/district-risk.data.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/routes", "src/components/ui", "src/components/RiskMap.tsx", "src/lib/utils.ts", "src/lib/district-risk.functions.ts", "src/lib/error-capture.ts", "src/lib/error-page.ts", "src/lib/lovable-error-reporting.ts", "src/router.tsx", "src/routeTree.gen.ts", "src/server.ts", "src/start.ts", "vite.config.ts"]
}
